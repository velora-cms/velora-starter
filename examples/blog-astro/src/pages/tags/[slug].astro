---
import Layout from "../../components/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import {
  fetchContentByPath,
  fetchContentById,
  parseTagSlugs,
  requireDocumentTypeId,
  searchAllContent,
  splitPostPath,
} from "../../lib/api";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return new Response("Not found", { status: 404 });
}

const tag = await fetchContentByPath(`/${slug}`);
if (!tag) {
  return new Response("Not found", { status: 404 });
}

// Authors and Tags share the content-tree root, so `/{slug}` can resolve
// to EITHER type — without this check /tags/jane-doe would render an
// Author node as a tag. Wrong type is the same outcome as no node: 404.
const tagTypeId = await requireDocumentTypeId("Tag");
if (tag.documentTypeId !== tagTypeId) {
  return new Response("Not found", { status: 404 });
}

const label = typeof tag.data.label === "string" ? tag.data.label : slug;

const postTypeId = await requireDocumentTypeId("Post");
const summaries = await searchAllContent(postTypeId);

const authorNameCache = new Map<string, string>();
async function authorName(authorSlug: string): Promise<string> {
  const cached = authorNameCache.get(authorSlug);
  if (cached) return cached;
  const author = await fetchContentByPath(`/${authorSlug}`);
  const name = typeof author?.data.name === "string" ? author.data.name : authorSlug;
  authorNameCache.set(authorSlug, name);
  return name;
}

const posts = (
  await Promise.all(
    summaries.map(async (summary) => {
      const split = splitPostPath(summary.path);
      if (!split) return null;
      const item = await fetchContentById(summary.id);
      if (!item) return null;
      // Exact slug match against the post's PARSED tag list (split on
      // commas, trimmed) — never a substring match on the raw text field
      // (S149's D3 recorded convention).
      if (!parseTagSlugs(item.data.tags).includes(slug)) return null;
      const title = typeof item.data.title === "string" ? item.data.title : split.postSlug;
      const publishedDate = typeof item.data.publishedDate === "string" ? item.data.publishedDate : undefined;
      return {
        title,
        authorSlug: split.authorSlug,
        postSlug: split.postSlug,
        authorName: await authorName(split.authorSlug),
        publishedDate,
        tags: parseTagSlugs(item.data.tags),
      };
    }),
  )
).filter((post): post is NonNullable<typeof post> => post !== null);

posts.sort((a, b) => (b.publishedDate ?? "").localeCompare(a.publishedDate ?? ""));
---

<Layout title={label}>
  <h1>Tag: {label}</h1>
  {posts.length === 0 ? (
    <p>No posts tagged &quot;{label}&quot; yet.</p>
  ) : (
    posts.map((post) => <PostCard {...post} />)
  )}
</Layout>
