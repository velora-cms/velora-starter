---
import Layout from "../../components/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import {
  fetchAllChildren,
  fetchContentByPath,
  fetchContentById,
  parseTagSlugs,
  requireDocumentTypeId,
  splitPostPath,
} from "../../lib/api";
import { renderRichText } from "../../lib/tiptap";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return new Response("Not found", { status: 404 });
}

const author = await fetchContentByPath(`/${slug}`);
if (!author) {
  return new Response("Not found", { status: 404 });
}

// Authors and Tags share the content-tree root, so `/{slug}` can resolve
// to EITHER type — without this check /authors/announcements would render
// a Tag node as an author. Wrong type is the same outcome as no node: 404.
const authorTypeId = await requireDocumentTypeId("Author");
if (author.documentTypeId !== authorTypeId) {
  return new Response("Not found", { status: 404 });
}

const name = typeof author.data.name === "string" ? author.data.name : slug;
const bioHtml = renderRichText(author.data.bio);

// Posts are the Author's direct children in the content tree
// (plugins/blog/src/plugin.tsx's treeRules) — no separate search needed.
const childSummaries = await fetchAllChildren(author.id);
const posts = (
  await Promise.all(
    childSummaries.map(async (summary) => {
      const split = splitPostPath(summary.path);
      if (!split) return null;
      const item = await fetchContentById(summary.id);
      if (!item) return null;
      const title = typeof item.data.title === "string" ? item.data.title : split.postSlug;
      const publishedDate = typeof item.data.publishedDate === "string" ? item.data.publishedDate : undefined;
      return {
        title,
        authorSlug: split.authorSlug,
        postSlug: split.postSlug,
        authorName: name,
        publishedDate,
        tags: parseTagSlugs(item.data.tags),
      };
    }),
  )
).filter((post): post is NonNullable<typeof post> => post !== null);

posts.sort((a, b) => (b.publishedDate ?? "").localeCompare(a.publishedDate ?? ""));
---

<Layout title={name}>
  <article class="author-detail">
    <h1>{name}</h1>
    <div class="rich-text" set:html={bioHtml} />
  </article>
  <h2>Posts by {name}</h2>
  {posts.length === 0 ? (
    <p>No posts published yet.</p>
  ) : (
    posts.map((post) => <PostCard {...post} />)
  )}
</Layout>
