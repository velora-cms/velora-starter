---
import Layout from "../components/Layout.astro";
import PostCard from "../components/PostCard.astro";
import {
  fetchContentByPath,
  fetchContentById,
  parseTagSlugs,
  requireDocumentTypeId,
  searchAllContent,
  splitPostPath,
} from "../lib/api";

// No prerender — every request re-reads the live content tree, so a
// newly-published post shows up with no rebuild (Session 150, D1).
export const prerender = false;

const postTypeId = await requireDocumentTypeId("Post");
const summaries = await searchAllContent(postTypeId);

// Author names aren't on the Post itself — cache by slug so posts by the
// same author (the common case) only fetch their author once per request.
const authorNameCache = new Map<string, string>();
async function authorName(slug: string): Promise<string> {
  const cached = authorNameCache.get(slug);
  if (cached) return cached;
  const author = await fetchContentByPath(`/${slug}`);
  const name = typeof author?.data.name === "string" ? author.data.name : slug;
  authorNameCache.set(slug, name);
  return name;
}

const posts = (
  await Promise.all(
    summaries.map(async (summary) => {
      const split = splitPostPath(summary.path);
      if (!split) return null; // not a Post at the expected /author/post depth
      const item = await fetchContentById(summary.id);
      if (!item) return null;
      const title = typeof item.data.title === "string" ? item.data.title : split.postSlug;
      const publishedDate = typeof item.data.publishedDate === "string" ? item.data.publishedDate : undefined;
      return {
        title,
        authorSlug: split.authorSlug,
        postSlug: split.postSlug,
        authorName: await authorName(split.authorSlug),
        publishedDate,
        tags: parseTagSlugs(item.data.tags),
      };
    }),
  )
).filter((post): post is NonNullable<typeof post> => post !== null);

posts.sort((a, b) => (b.publishedDate ?? "").localeCompare(a.publishedDate ?? ""));
---

<Layout title="Posts">
  <h1>Posts</h1>
  {posts.length === 0 ? (
    <p>No posts published yet.</p>
  ) : (
    posts.map((post) => <PostCard {...post} />)
  )}
</Layout>
