---
import Layout from "../components/Layout.astro";

// BROWSER-DIRECT POST, NO API KEY: unlike src/lib/api.ts's server-side
// client (VELORA_API_URL + VELORA_API_KEY, read only on the server and
// never sent to the browser), the <script> below runs IN THE VISITOR'S
// BROWSER and POSTs straight to the CMS's public plugin route
// (POST /api/plugins/com.velora.forms/submit) with no credential of any
// kind attached — that's the point this page demonstrates (Task 1's
// genuinely un-credentialed `public` plugin-route tier). It uses ONLY the
// `PUBLIC_VELORA_API_URL` env var — Astro's PUBLIC_-prefix convention is
// what makes a variable readable from client-side code; VELORA_API_KEY
// must never gain a PUBLIC_ twin, or every visitor's browser could read it
// via view-source.
//
// This only works when the CMS operator has allowlisted THIS site's
// origin in VELORA_CORS_ORIGINS on the Velora server — see
// plugins/forms/README.md's CORS section and
// apps/server/src/config/cors.ts. Without that allowlist entry, the
// fetch() below is blocked by the browser's CORS check and the form shows
// the error state (a plain, non-JS <form> POST would still reach the
// endpoint either way, since CORS only governs script-initiated
// cross-origin requests — this page chooses fetch() so it can render the
// JSON response inline without a full-page navigation).
//
// The admin must create a form with slug "contact" (fields: name, email,
// message) in the Forms section before this page will accept submissions
// — see README.md.
export const prerender = false;
---

<Layout title="Contact">
  <h1>Contact</h1>
  <p>
    Sends straight to your Velora instance's Forms plugin — no server round
    trip through this site. Requires a form with slug <code>contact</code>
    to exist and be enabled.
  </p>

  <form id="contact-form">
    <!-- Honeypot: no real visitor's browser ever fills this in, since it's
         positioned off-screen (a logical-property offset, not
         display:none, so it still reads as a normal field to a bot that
         skips hidden inputs). tabindex="-1" keeps it out of keyboard tab
         order for a sighted visitor tabbing through the form;
         autocomplete="off" stops a browser's own autofill from
         accidentally populating it. Any non-empty value here makes the
         CMS treat the submission as spam — see contact-form.ts and
         plugins/forms/README.md. -->
    <div aria-hidden="true" style="position:absolute;inset-inline-start:-9999px">
      <label for="website">Website</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <label for="name">Name</label>
    <input type="text" id="name" name="name" required />

    <label for="email">Email</label>
    <input type="email" id="email" name="email" required />

    <label for="message">Message</label>
    <textarea id="message" name="message" required></textarea>

    <button type="submit">Send</button>
  </form>
  <p id="contact-status" role="status"></p>
</Layout>

<script>
  import { buildSubmitUrl, collectValues } from "../lib/contact-form.js";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>("#contact-status");
  const apiBase = import.meta.env.PUBLIC_VELORA_API_URL as string | undefined;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    if (!apiBase) {
      status.textContent = "This site isn't configured with PUBLIC_VELORA_API_URL — see .env.example.";
      return;
    }

    status.textContent = "Sending…";
    const { website, values } = collectValues(new FormData(form));

    try {
      const response = await fetch(buildSubmitUrl(apiBase), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug: "contact", values, website }),
      });
      // 200 covers both a genuine success and a silently-dropped honeypot
      // hit (plugins/forms/README.md) — the two are indistinguishable by
      // design, so this page can't (and shouldn't try to) tell them apart
      // either.
      const body: unknown = await response.json().catch(() => null);
      const message = body && typeof body === "object" && "message" in body ? String(body.message) : undefined;
      if (response.ok) {
        status.textContent = "Thanks — your message was sent.";
        form.reset();
      } else if (response.status === 429) {
        status.textContent = message ?? "Too many submissions from this address — try again later.";
      } else {
        status.textContent = message ?? "Something went wrong — please try again.";
      }
    } catch {
      status.textContent = "Something went wrong — please try again. If this keeps happening, this site's origin may not be allowlisted on the CMS (VELORA_CORS_ORIGINS).";
    }
  });
</script>
