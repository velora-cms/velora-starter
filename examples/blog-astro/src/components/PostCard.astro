---
interface Props {
  title: string;
  authorName: string;
  authorSlug: string;
  postSlug: string;
  publishedDate?: string;
  tags: string[];
}

const { title, authorName, authorSlug, postSlug, publishedDate, tags } = Astro.props;
---

<article class="post-card">
  <h2><a href={`/posts/${authorSlug}/${postSlug}`}>{title}</a></h2>
  <p class="post-meta">
    By <a href={`/authors/${authorSlug}`}>{authorName}</a>
    {publishedDate && (
      <>
        {" · "}
        <time datetime={publishedDate}>{publishedDate}</time>
      </>
    )}
  </p>
  {tags.length > 0 && (
    <ul class="tag-chips">
      {tags.map((tag) => (
        <li><a class="tag-chip" href={`/tags/${tag}`}>{tag}</a></li>
      ))}
    </ul>
  )}
</article>
