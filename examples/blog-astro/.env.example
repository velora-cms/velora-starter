# The origin of your running Velora instance. The API key is only ever
# used server-side; the browser only fetches presigned media URLs (no
# key attached).
VELORA_API_URL=http://localhost:3000

# API key for your Velora instance. Create this in the Velora admin
# under Settings > API Keys — requires VELORA_HEADLESS=true on the
# server (see README.md).
VELORA_API_KEY=

# The CMS origin the CONTACT PAGE posts to directly from the visitor's
# browser (src/pages/contact.astro) — no API key involved, since
# POST /api/plugins/com.velora.forms/submit is a genuinely un-credentialed
# public route. The PUBLIC_ prefix is Astro's convention for a variable
# that gets inlined into client-side code; unlike VELORA_API_URL above,
# this one is readable by every visitor's browser, so it must never be
# given a value that isn't meant to be public (it's just an origin, so
# that's fine). Usually the same value as VELORA_API_URL.
#
# Requires the Velora server to allowlist this site's origin in
# VELORA_CORS_ORIGINS, and a form with slug "contact" (fields: name,
# email, message) to exist in the Forms admin section — see README.md.
PUBLIC_VELORA_API_URL=http://localhost:3000

# --- Try it against the hosted demo (no setup) ---
# VELORA_API_URL=https://demo.velora-cms.com
# VELORA_API_KEY=vk_4ac0a6b78b953a13b8646e6379fcbb6bee1a269af253a14eebce668572019328
# PUBLIC_VELORA_API_URL=https://demo.velora-cms.com
# (Read-only demo key: intentionally public, rate-limited, may rotate.)
